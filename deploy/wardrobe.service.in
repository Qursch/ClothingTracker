[Unit]
Description=Wardrobe Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/start-server.sh
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
